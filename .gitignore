# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment variables (keep .env.example tracked)
.env

# SQLite databases (keep data/.gitkeep tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/backups/

# Log files (keep logs/.gitkeep tracked)
logs/*.log

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store
