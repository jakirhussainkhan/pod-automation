# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Bare env / key files (safety net — e.g. `env0`)
env0
env

# Environment variables (keep .env.example tracked)
.env
.env*
!.env.example

# SQLite databases (keep data/.gitkeep tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite3
data/backups/
*.sqlite-wal
*.sqlite-shm

# Log files (keep logs/.gitkeep tracked)
logs/*.log
*.log
*.out

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Editor backups
*.bak

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store
