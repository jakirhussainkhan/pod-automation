# Human-readable application name shown in docs, logs and health checks.
APP_NAME=POD Facebook Automation Dashboard
# Runtime environment: development or production.
APP_ENV=development
# Enable debug mode and auto-reload (true in development, false in production).
DEBUG=true
# Host interface the server binds to.
HOST=127.0.0.1
# TCP port the server listens on.
PORT=8000
# Allowed CORS origins (local-only, JSON list, no wildcards). Defaults to
# 127.0.0.1/localhost on ports 8000/3000/5173/8080. Example:
# CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# SQLAlchemy database URL (SQLite file used in Phase 1).
DATABASE_URL=sqlite:///./data/automation.db
# Active AI provider: groq or openai.
AI_PROVIDER=groq
# API key for Groq. SECURITY: never commit a real key; if it was ever exposed,
# rotate it in the Groq console immediately and set the new value here.
GROQ_API_KEY=
# API key for OpenAI (leave empty until Phase 4).
OPENAI_API_KEY=
# Default Groq model identifier.
GROQ_MODEL=qwen/qwen3.8-27b
# Default OpenAI model identifier.
OPENAI_MODEL=gpt-4o-mini
# Sampling temperature for AI generation (0.0-2.0).
AI_TEMPERATURE=0.8
# Maximum tokens per AI response.
AI_MAX_TOKENS=800
# Timeout in seconds for AI provider requests.
AI_TIMEOUT_SECONDS=30
# Maximum retry attempts per AI provider before falling back.
AI_MAX_RETRIES=3
# Enable automatic fallback to the other AI provider on failure.
AI_FALLBACK_ENABLED=true
# Use the deterministic mock AI provider (no network calls, no keys needed).
AI_MOCK_MODE=false
# Default language for generated posts.
DEFAULT_POST_LANGUAGE=English
# Default brand voice for generated posts.
DEFAULT_BRAND_VOICE="friendly, witty, and persuasive"
# Facebook Page ID to automate (configured in a later phase).
FACEBOOK_PAGE_ID=
# Facebook Page access token (configured in a later phase).
FACEBOOK_PAGE_ACCESS_TOKEN=
# Graph API version. Check Meta's developer docs for the current version and update if needed.
FACEBOOK_GRAPH_VERSION=v21.0
# When True, publishing is simulated (fake ids prefixed dryrun_) and no real Facebook request is made.
FACEBOOK_DRY_RUN=true
# Enable the Automation background scheduler loop.
SCHEDULER_ENABLED=true
# Seconds between scheduler ticks (minimum 10).
SCHEDULER_INTERVAL_SECONDS=30
# Maximum posts published per scheduler tick.
SCHEDULER_BATCH_SIZE=5
# Maximum publish attempts before a failed post stops being auto-retried.
PUBLISH_MAX_ATTEMPTS=3
# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
